# Copy this file to .env.local and fill in the two values from
# Supabase > Project Settings > API. Both are safe to ship in the app (the anon key is public;
# the database is protected by the row level security in supabase/schema.sql).
# Never put the "service_role" key here.
VITE_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
